# build output
dist/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store
.direnv

# next.js
.next/
next-env.d.ts
*.tsbuildinfo

# python
.venv/
__pycache__/
*.pyc

# data: raw downloads and the DuckDB file are reproducible via
# `uv run bmore-casa refresh`; Parquet and public/data assets are kept
# so the app and notebook run straight after a clone.
notebook/data/raw/
notebook/data/processed/*.duckdb

# secrets
.env*.local

# copied from node_modules on postinstall
web/public/maplibre/
web/public/draco/

# marimo session cache
__marimo__/

# agent instructions (web/AGENTS.md is re-generated by `next dev`)
AGENTS.md
CLAUDE.md

# private notes
notes/
